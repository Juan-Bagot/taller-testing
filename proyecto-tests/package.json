{
  "name": "proyecto-tests",
  "private": true,
  "description": "Tests automatizados de la clínica — punto de partida del obligatorio",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed --project=escritorio",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "baselines": "playwright test --update-snapshots",
    "codegen": "playwright codegen http://localhost:9080"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.7.0"
  }
}
